# ---------------------------------------------------------------------------
# AgencyFlow CRM — environment configuration
# Copy this file to `.env` and adjust. `.env` is git-ignored and must never be
# committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# SQLite database file, relative to the prisma/ directory.
# Swap for a postgresql:// URL and change the datasource provider in
# prisma/schema.prisma to move to Postgres.
DATABASE_URL="file:./dev.db"

# Secret used to sign the session JWT stored in an httpOnly cookie.
# Generate your own before deploying anywhere real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-hex-string"

# How long a login session stays valid.
SESSION_MAX_AGE_DAYS="7"

# Shown on the login screen so reviewers know how to get in.
# Set to "false" for a real deployment.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="true"

# Password given to every seeded demo user.
SEED_DEMO_PASSWORD="demo1234"
